{
  "name": "smart-home-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Modular Node.js backend for the Smart Home platform",
  "type": "module",
  "main": "src/server.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "check": "node --check src/server.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@smart-home/modbus": "*",
    "@smart-home/serial-port": "*",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0"
  }
}
